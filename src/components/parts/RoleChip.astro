---
// A NAND chip (or the controller, for the current role) on the drive, lettered with one role: years, company, title and
// the result. Port of design/lee-ssd.html chip().
import Chip from '../svg/Chip.astro';
import { wrap, fit, clip } from '../../lib/text';
import type { Role } from '../../lib/schema';
interface Props { role: Role; lit: 1 | 2 | 3; x: number; y: number; w: number; h: number; lead: { side: 't' | 'b'; len: number }; chars: number }
const { role: r, lit, x, y, w, h, lead, chars } = Astro.props;
const now = r.to == null, years = `${r.from} – ${r.to ?? 'NOW'}`, tx = x + 16, room = w - 32;
const head = `${r.kind} · ${years}`;
// the result runs one line every 16 from y + 110, and stops inside the chip; the whole text is in the details
const lines = clip(wrap(r.impact, chars), Math.floor((h - 118) / 16) + 1);
---
<Chip x={x} y={y} w={w} h={h} pins={now ? 'tblr' : 'tb'} pitch={8} len={4} lit={lit}
      probe={{ key: r.id, label: `${r.title} at ${r.company}, ${years}. ${r.impact}`, lead }}>
  <text x={tx} y={y + 28} font-size={fit(head, now ? room - 64 : room, 11, 0.5)} class="lab in">{head}</text>
  {now && <text x={x + w - 16} y={y + 28} font-size="10.5" text-anchor="end" class="lt">CURRENT</text>}
  <text x={tx} y={y + 58} font-size={fit(r.company, room, 19, 0.6)} class="lt">{r.company}</text>
  <text x={tx} y={y + 80} font-size={fit(r.title, room, 13, 0.5)} class="lab in">{r.title}</text>
  <path d={`M${tx} ${y + 92}H${x + w - 16}`} class="thin in" />
  {lines.map((l, i) => <text x={tx} y={y + 110 + i * 16} font-size="12" class="mk">{l}</text>)}
</Chip>
