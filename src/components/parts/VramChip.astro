---
// A memory chip on the graphics card holding one project: slot, stack, name and its result. Probed, its lead shoots out
// of its outer (right) end, clear of the chips stacked beside it. Port of design/lee-gpu.html vram().
import Chip from '../svg/Chip.astro';
import type { Project } from '../../lib/schema';
interface Props { project: Project; index: number; x: number; y: number; w: number; h: number; narrow?: boolean }
const { project: p, index, x, y, w, h, narrow = false } = Astro.props;
const stack = p.stack.join(' · ').toUpperCase();
---
<Chip x={x} y={y} w={w} h={h} pins="tb" pitch={8} len={4} lit={2}
      probe={{ key: p.id, label: `${p.name}. Problem: ${p.problem}. What I did: ${p.fix}. Result: ${p.result}`, lead: { side: 'r', len: narrow ? 8 : 12 } }}>
  <text x={x + 16} y={y + 24} font-size="10.5" class="lab in">VRAM_0{index + 1}</text>
  <text x={x + w - 16} y={y + 24} font-size="10.5" text-anchor="end" class="lab in">{stack}</text>
  <text x={x + 16} y={y + h / 2 + 6} font-size={narrow ? 18 : 21} class="lt">{p.name}</text>
  <text x={x + 16} y={y + h - 20} font-size="13" class="mk">→ {p.result}</text>
</Chip>
