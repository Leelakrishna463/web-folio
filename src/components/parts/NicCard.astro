---
// The network card: I/O bracket with four RJ45 jacks and their PHYs (ports), the lit controller lettered with the email,
// the buffers, and the keyed PCIe x4 edge in its slot (the résumé). Port of design/lee-nic.html.
import Probe from '../svg/Probe.astro';
import Chip from '../svg/Chip.astro';
import Lines from '../svg/Lines.astro';
import Led from '../svg/Led.astro';
import Net from '../svg/Net.astro';
import EdgeConnector from '../svg/EdgeConnector.astro';
import Socket from '../svg/Socket.astro';
import { fit } from '../../lib/text';
import type { Profile } from '../../lib/schema';
import type { Pt } from '../../lib/geom/path';
interface Props { mode: 'wide' | 'narrow'; profile: Profile }
const { mode, profile } = Astro.props;
const EMAIL = profile.email;
const RJ = (x: number, y: number, w: number, h: number) => {
  const lx = x + w * 0.2, lw = w * 0.6;
  return { x, y, w, h, lx, lw, d: Array.from({ length: 8 }, (_, i) => `M${(lx + 4 + (i * (lw - 8)) / 7).toFixed(1)} ${y + h * 0.3}v${(h * 0.22).toFixed(1)}`).join(' ') };
};
const BUF = [['EVERY MESSAGE', 'GETS A REPLY'], ['NOTHING', 'DROPPED'], ['USUALLY', 'WITHIN'], [profile.replyTime.toUpperCase(), 'BUFFER']];
const ctrlRows = (big: boolean): [string, number, string, number?][] => big
  ? [['EMAIL', 13, 'lab in', 2], [EMAIL, fit(EMAIL, C.s - 24, 20, 0.56), 'lt', 4], ['ONE ADDRESS', 11, 'lab in'], ['ALWAYS LISTENING', 11, 'lab in', 8], ['LEE-NIC CONTROLLER', 9.5, 'num']]
  : [['EMAIL', 12, 'lab in', 2], [EMAIL, fit(EMAIL, NC.w - 24, 19, 0.56), 'lt', 4], ['ONE ADDRESS', 10.5, 'lab in'], ['ALWAYS LISTENING', 10.5, 'lab in', 6], ['LEE-NIC CONTROLLER', 9, 'num']];
const labels = {
  ports: `Ethernet ports: link up, ${profile.status.text.toLowerCase()}.`,
  ctrl: `Controller: email ${EMAIL}. Activate to copy.`,
  buf: `Buffers: nothing dropped. Every message gets a reply, usually within ${profile.replyTime}.`,
  pcie: 'PCIe connector: ready to slot in. Downloads the résumé.',
};
const LINK = `LINK UP · ${profile.status.text.toUpperCase()}`;

// wide geometry
const X0 = 60, X1 = 800, Y0 = 140, Y1 = 500, C = { x: 360, y: 180, s: 220 }, BX = 620, BW = 80, BH = 66;
const jacks = [0, 1, 2, 3].map((k) => ({ k, jy: Y0 + 18 + k * 84 }));
// narrow geometry
const NX0 = 24, NX1 = 330, NY0 = 40, NY1 = 712, NC = { x: 50, y: 72, w: 230, h: 190 };
---
{mode === 'wide' ? <>
  <rect x={X0} y={Y0} width={X1 - X0} height={Y1 - Y0} class="paper pcb" />
  <circle cx={X1 - 18} cy={Y0 + 18} r="6" class="paper" />
  <text x={X0 + 200} y={Y0 + 22} font-size="10.5" class="num">LEE-NIC · 4 × 2.5 GbE</text>
  {jacks.map(({ jy }) => <Net points={[[X0 + 112, jy + 33], [X0 + 146, jy + 33]]} keys="ports" square />)}
  {jacks.map(({ k, jy }) => { const ey = C.y + 40 + k * 46, lane = X0 + 246 + (k < 2 ? k : 3 - k) * 10;
    return <Net points={[[X0 + 228, jy + 33], [lane, jy + 33], [lane, ey], [C.x - 6, ey]] as Pt[]} keys="ports" r={6} />; })}
  <Net points={[[C.x + C.s + 7, 225], [BX - 5, 225]]} keys="buf" square />
  <Net points={[[C.x + C.s + 7, 325], [BX - 5, 325]]} keys="buf" square />
  <Net points={[[C.x + C.s / 2, C.y + C.s + 7], [C.x + C.s / 2, Y1 - 16]]} keys="pcie ctrl" square />
  <Probe key="ports" label={labels.ports} lead={{ from: [X0 + 56, Y0 + 13], dir: 'u', len: 24 }}>
    <rect x={X0 - 26} y={Y0 - 12} width="26" height={Y1 - Y0 + 24} class="paper" />
    <text x={X0 - 13} y={(Y0 + Y1) / 2} font-size={fit(LINK, Y1 - Y0, 11, 0.6)} text-anchor="middle" dominant-baseline="central" class="lt" transform={`rotate(-90 ${X0 - 13} ${(Y0 + Y1) / 2})`}>{LINK}</text>
    {jacks.map(({ k, jy }) => { const j = RJ(X0 + 4, jy, 104, 66); return <>
      <rect x={j.x} y={j.y} width={j.w} height={j.h} class="body" />
      <rect x={j.lx} y={j.y + j.h * 0.22} width={j.lw} height={j.h * 0.56} class="paper" />
      <path d={j.d} class="thin" />
      <Led x={j.x + 4} y={j.y + 4} ok />
      <Led x={j.x + j.w - 11} y={j.y + 4} blink delay={k * 0.9} />
      <Chip x={X0 + 150} y={jy + 13} w={74} h={40} pins="tb" pitch={8} len={4} label={`PHY ${k + 1}`} labelMax={11} labelClass="lab in" />
    </>; })}
  </Probe>
  <Probe key="ctrl" label={labels.ctrl} copy={EMAIL} lead={{ from: [C.x + C.s / 2, C.y - 7], dir: 'u', len: 24 }} class="l3">
    <Chip x={C.x} y={C.y} w={C.s} h={C.s} pins="tblr" pitch={10} len={6}>
      <rect x={C.x + 22} y={C.y + 22} width={C.s - 44} height={C.s - 44} class="thin in" />
      <Lines x={C.x + C.s / 2} y={C.y + C.s / 2 - 36} rows={ctrlRows(true)} lh={1.4} />
    </Chip>
  </Probe>
  <Probe key="buf" label={labels.buf} lead={{ from: [BX + BW + 6, 185], dir: 'u', len: 24 }}>
    {BUF.map((w, b) => { const bx = BX + (b % 2) * (BW + 12), by = 192 + Math.floor(b / 2) * (BH + 34);
      return <Chip x={bx} y={by} w={BW} h={BH} pins="tb" pitch={8} len={4}>
        <Lines x={bx + BW / 2} y={by + BH / 2 - 8} rows={[[w[0], fit(w[0], BW - 2, 10, 0.6), 'lt'], [w[1], 10, b === 3 ? 'num' : 'lt']]} lh={1.45} />
      </Chip>; })}
  </Probe>
  <Probe key="pcie" label={labels.pcie} href={profile.resumeUrl} lead={{ from: [500, Y1 + 33], dir: 'd', len: 24 }}>
    <EdgeConnector x={416} y={Y1} len={168} d={24} side="b" key={39} pitch={8} snug />
    <Socket x={408} y={Y1 + 15} w={184} h={17} />
    <text x="600" y={Y1 - 24} font-size="12" class="lt">READY TO SLOT IN</text>
    <text x="600" y={Y1 - 8} font-size="10.5" class="num">PCIe x4 · RÉSUMÉ</text>
  </Probe>
</> : <>
  <rect x={NX0} y={NY0} width={NX1 - NX0} height={NY1 - NY0} class="paper pcb" />
  <Net points={[[120, NC.y + NC.h + 5], [120, 296]]} keys="buf" square />
  <Net points={[[234, NC.y + NC.h + 5], [234, 296]]} keys="buf" square />
  {[0, 1, 2, 3].map((k) => { const px = 38 + k * 70, hy = 498 - k * 5, lane = 41 - k * 5, ey = NC.y + 40 + (3 - k) * 30;
    return <>
      <Net points={[[px + 32, 552], [px + 32, 578]]} keys="ports" square />
      <Net points={[[px + 32, 508], [px + 32, hy], [lane, hy], [lane, ey], [NC.x - 5, ey]] as Pt[]} keys="ports" r={3} />
    </>; })}
  <Probe key="pcie" label={labels.pcie} href={profile.resumeUrl} lead={{ from: [NX1 - 16, NY0 + 100], dir: 'l', len: 16 }}>
    <EdgeConnector x={NX1} y={NY0 + 26} len={148} d={16} side="r" key={69} pitch={7} snug />
    <Socket x={NX1 + 10} y={NY0 + 18} w={14} h={164} />
  </Probe>
  <Probe key="ctrl" label={labels.ctrl} copy={EMAIL} lead={{ from: [NC.x + NC.w / 2, NC.y + NC.h + 7], dir: 'd', len: 16 }} class="l3">
    <Chip x={NC.x} y={NC.y} w={NC.w} h={NC.h} pins="tblr" pitch={10} len={5}>
      <Lines x={NC.x + NC.w / 2} y={NC.y + NC.h / 2 - 34} rows={ctrlRows(false)} lh={1.4} />
    </Chip>
  </Probe>
  <Probe key="buf" label={labels.buf} lead={{ from: [172, 293], dir: 'u', len: 16 }}>
    {BUF.map((w, b) => { const bx = 50 + (b % 2) * 124, by = 300 + Math.floor(b / 2) * 84;
      return <Chip x={bx} y={by} w={116} h={58} pins="tb" pitch={8} len={4}>
        <Lines x={bx + 58} y={by + 21} rows={[[w[0], fit(w[0], 110, 10.5, 0.6), 'lt'], [w[1], 10.5, b === 3 ? 'num' : 'lt']]} lh={1.45} />
      </Chip>; })}
  </Probe>
  <Probe key="ports" label={labels.ports} lead={{ from: [172, 491], dir: 'u', len: 16 }}>
    {[0, 1, 2, 3].map((k) => { const px = 38 + k * 70, j = RJ(px, 582, 64, 104); return <>
      <Chip x={px + 6} y={512} w={52} h={36} pins="lr" pitch={8} len={3} label={`PHY ${k + 1}`} labelMax={10} labelClass="lab in" />
      <rect x={j.x} y={j.y} width={j.w} height={j.h} class="body" />
      <rect x={j.lx} y={j.y + j.h * 0.22} width={j.lw} height={j.h * 0.56} class="paper" />
      <path d={j.d} class="thin" />
      <Led x={j.x + 4} y={j.y + 4} ok />
      <Led x={j.x + j.w - 11} y={j.y + 4} blink delay={k * 0.9} />
    </>; })}
    <rect x={NX0 - 10} y={NY1} width={NX1 - NX0 + 20} height="24" class="paper" />
    <text x={(NX0 + NX1) / 2} y={NY1 + 12} font-size={fit(LINK, NX1 - NX0, 10.5, 0.6)} text-anchor="middle" dominant-baseline="central" class="lt">{LINK}</text>
  </Probe>
</>}
